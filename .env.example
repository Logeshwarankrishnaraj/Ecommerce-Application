# Copy to .env (never commit .env). Used by docker-compose and when running the backend with env vars.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jewel_store
DB_USERNAME=jewel_app
DB_PASSWORD=change-me
DB_USE_SSL=true

# Public URL of the storefront (used in emails and CORS)
APP_PUBLIC_BASE_URL=https://shop.example.com
CORS_ALLOWED_ORIGINS=https://shop.example.com
COOKIE_SECURE=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=no-reply@example.com
ADMIN_ALERT_EMAILS=owner@example.com

MEDIA_STORAGE_PATH=/var/commerce/media

# disabled | <provider code>. The only provider shipped is a dev-only mock; a real gateway needs a PaymentProvider implementation.
PAYMENT_MODE=disabled
PAYMENT_WEBHOOK_SECRET=

# First start on an empty production DB only: creates the first super admin, then REMOVE these two lines.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
